# This file is in the fastlane/ dir
# See https://docs.fastlane.tools/actions/ for available actions

default_platform(:ios)

platform :ios do
  before_all do
    # 1. Bundler를 사용하여 fastlane 및 플러그인 의존성 설치
    ensure_bundle_install
    # Xcode 프로젝트의 최신 코드 변경 사항을 가져옵니다.
    # git_pull
  end

  desc "TestFlight에 새로운 베타 빌드를 배포합니다."
  lane :beta do
    # 2. 인증서 및 프로비저닝 프로파일 관리 (match)
    #    - type: 배포 유형 (appstore, adhoc, development)
    #    - app_identifier: 앱의 번들 ID
    #    - git_url: 인증서를 저장할 별도의 private Git 저장소 URL
    match(
      type: "appstore",
      app_identifier: "{{APP_IDENTIFIER}}",
      git_url: "https://github.com/S-O-S-AI-AGENT/AI-AGENT-FE-certificates" # 인증서 저장소 (별도 생성 필요)
    )

    # 3. 빌드 번호 자동 증가
    #    - 최신 TestFlight 빌드 번호를 가져와 1 증가시킵니다.
    latest_build_number = latest_testflight_build_number(
      app_identifier: "{{APP_IDENTIFIER}}",
      apple_id: "{{APPLE_ID}}"
    )
    increment_build_number(
      build_number: latest_build_number + 1,
      xcodeproj: "YourApp.xcodeproj" # TODO: 실제 Xcode 프로젝트 파일 경로로 변경하세요.
    )

    # 4. 앱 빌드 (gym)
    #    - scheme: 빌드할 Xcode 스킴 이름
    gym(
      scheme: "YourAppScheme", # TODO: 실제 Xcode 스킴 이름으로 변경하세요.
      export_method: "app-store"
    )

    # 5. TestFlight에 업로드 (pilot)
    pilot(
      apple_id: "{{APPLE_ID}}",
      app_identifier: "{{APP_IDENTIFIER}}",
      skip_waiting_for_build_processing: true # 빌드 처리 대기 없이 Fastlane 종료
    )

    # (선택) Slack 알림
    # slack(
    #   message: "성공적으로 새로운 베타 빌드를 TestFlight에 배포했습니다! 🚀"
    # )
  end

  error do |lane, exception|
    # (선택) 실패 시 Slack 알림
    # slack(
    #   message: "Fastlane 배포 실패: #{lane} - #{exception.message}",
    #   success: false
    # )
  end
end
